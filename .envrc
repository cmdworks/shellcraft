# Local sandbox for trying shellcraft without touching your real shell setup.
# Run `direnv allow` once. Config, data and cache go to ./.sandbox; the local build is on PATH.
export XDG_CONFIG_HOME="$PWD/.sandbox/config"
export XDG_DATA_HOME="$PWD/.sandbox/data"
export XDG_CACHE_HOME="$PWD/.sandbox/cache"
unset SHELLCRAFT_CONFIG
PATH_add target/debug

# Short commands (not aliases: direnv cannot set those), created in ./.sandbox/bin:
#   sc-build      cargo build
#   sc            the freshly built shellcraft
#   try-zsh|bash|fish|nu   a throw-away shell with shellcraft loaded (scripts/try.sh)
mkdir -p .sandbox/bin
for s in zsh bash fish nu; do
  printf '#!/bin/sh\nexec "%s/scripts/try.sh" %s\n' "$PWD" "$s" > ".sandbox/bin/try-$s"
done
printf '#!/bin/sh\ncd "%s" && exec cargo build "$@"\n' "$PWD" > .sandbox/bin/sc-build
printf '#!/bin/sh\nexec "%s/target/debug/shellcraft" "$@"\n' "$PWD" > .sandbox/bin/sc
chmod +x .sandbox/bin/*
PATH_add .sandbox/bin
