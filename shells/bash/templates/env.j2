# --- environment ---
# Homebrew: same variables as `brew shellenv`, without spawning brew (about 10 ms)
for _sc_b in /opt/homebrew:/opt/homebrew /usr/local:/usr/local/Homebrew /home/linuxbrew/.linuxbrew:/home/linuxbrew/.linuxbrew/Homebrew; do
  if [ -x "${_sc_b%%:*}/bin/brew" ]; then
    export HOMEBREW_PREFIX=${_sc_b%%:*} HOMEBREW_CELLAR=${_sc_b%%:*}/Cellar HOMEBREW_REPOSITORY=${_sc_b#*:}
    case ":$PATH:" in *":$HOMEBREW_PREFIX/bin:"*) ;; *) PATH="$HOMEBREW_PREFIX/bin:$HOMEBREW_PREFIX/sbin:$PATH" ;; esac
    case ":${MANPATH-}:" in *":$HOMEBREW_PREFIX/share/man:"*) ;; *) export MANPATH="$HOMEBREW_PREFIX/share/man${MANPATH:+:$MANPATH}:" ;; esac
    case ":${INFOPATH-}:" in *":$HOMEBREW_PREFIX/share/info:"*) ;; *) export INFOPATH="$HOMEBREW_PREFIX/share/info:${INFOPATH:-}" ;; esac
    break
  fi
done
unset _sc_b
case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) PATH="$HOME/.local/bin:$PATH" ;; esac
export PATH
{% for name, value in env|items %}export {{ name }}={{ value|q }}
{% endfor %}
{%- if plugins.list %}
# plugins: not supported by the bash emitter yet ({{ plugins.list|length }} configured)
{% endif %}
