# --- completion ---
if ! shopt -oq posix; then
  if [ -r /opt/homebrew/etc/profile.d/bash_completion.sh ]; then
    . /opt/homebrew/etc/profile.d/bash_completion.sh
  elif [ -r /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
  elif [ -r /etc/bash_completion ]; then
    . /etc/bash_completion
  fi
fi

{%- if completion.help %}
{% raw %}# Commands without a completion spec: flags and subcommands learned from --help (bash 4.1+,
# and only when bash-completion's own loader is absent)
if (( BASH_VERSINFO[0] > 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] >= 1) )) \
   && ! declare -F _completion_loader >/dev/null && command -v shellcraft >/dev/null; then
  _sc_default_complete() {
    local line
    COMPREPLY=()
    while IFS= read -r line; do COMPREPLY+=("${line%%$'\t'*}"); done \
      < <(command shellcraft complete -- "${COMP_WORDS[@]:0:COMP_CWORD+1}" 2>/dev/null)
  }
  complete -o bashdefault -o default -D -F _sc_default_complete
fi
{% endraw %}{%- endif %}

