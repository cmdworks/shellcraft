# --- environment (fish manages its own history; [shell] history_size is not used) ---
for _sc_b in /opt/homebrew:/opt/homebrew /usr/local:/usr/local/Homebrew /home/linuxbrew/.linuxbrew:/home/linuxbrew/.linuxbrew/Homebrew
    set -l parts (string split : $_sc_b)
    if test -x $parts[1]/bin/brew
        set -gx HOMEBREW_PREFIX $parts[1]
        set -gx HOMEBREW_CELLAR $parts[1]/Cellar
        set -gx HOMEBREW_REPOSITORY $parts[2]
        fish_add_path -g $parts[1]/bin $parts[1]/sbin
        break
    end
end
set -e _sc_b
fish_add_path -g $HOME/.local/bin
{% for name, value in env|items %}set -gx {{ name }} {{ value|q }}
{% endfor %}
{%- if plugins.list %}
# plugins: not supported by the fish emitter yet ({{ plugins.list|length }} configured)
{% endif %}
