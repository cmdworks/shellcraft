# --- environment ---
typeset -U path PATH fpath manpath infopath
# Homebrew: same variables as `brew shellenv`, without spawning brew (about 10 ms)
for _sc_b in /opt/homebrew:/opt/homebrew /usr/local:/usr/local/Homebrew /home/linuxbrew/.linuxbrew:/home/linuxbrew/.linuxbrew/Homebrew; do
  if [[ -x ${_sc_b%%:*}/bin/brew ]]; then
    export HOMEBREW_PREFIX=${_sc_b%%:*} HOMEBREW_CELLAR=${_sc_b%%:*}/Cellar HOMEBREW_REPOSITORY=${_sc_b#*:}
    path=($HOMEBREW_PREFIX/bin $HOMEBREW_PREFIX/sbin $path)
    [[ -d $HOMEBREW_PREFIX/share/zsh/site-functions ]] && fpath=($HOMEBREW_PREFIX/share/zsh/site-functions $fpath)
    manpath=($HOMEBREW_PREFIX/share/man $manpath)
    infopath=($HOMEBREW_PREFIX/share/info $infopath)
    break
  fi
done
unset _sc_b
path=("$HOME/.local/bin" $path)
for _sc_d in "$HOME/.atuin/bin" "$HOME/.fzf/bin" "${BUN_INSTALL:-$HOME/.bun}/bin"; do
  [[ -d $_sc_d ]] && path=("$_sc_d" $path)
done
unset _sc_d
{% for name, value in env|items %}export {{ name }}={{ value|q }}
{% endfor %}
