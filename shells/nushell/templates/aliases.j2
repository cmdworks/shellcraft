alias gs = git status -sb
alias gl = git log --oneline --graph --decorate -20
alias gd = git diff
alias gds = git diff --staged
alias ga = git add
alias gc = git commit
alias gp = git push
alias gpl = git pull --ff-only
alias gco = git checkout
alias gb = git branch
{% for name, value in aliases|items %}alias {{ name }} = {{ value }}
{% endfor %}
def --env mkcd [dir: string] {
    mkdir $dir
    cd $dir
}
def path-list [] {
    $env.PATH
}

