---
source: shells/all/tests/snapshots.rs
expression: "render(ShellKind::Fish, cfg)"
---
# shellcraft: generated for fish. Do not edit; change shellcraft.toml and run `shellcraft apply`.
status is-interactive; or return 0
set -g _sc_cache (test -n "$XDG_CACHE_HOME"; and echo $XDG_CACHE_HOME; or echo $HOME/.cache)/shellcraft
# fish highlights as you type; these are the theme's colours
set -g fish_color_command green
set -g fish_color_error red
set -g fish_color_param cyan
set -g fish_color_quote yellow
set -g fish_color_operator blue
set -g fish_color_comment brblack
set -g fish_color_redirection brblue

# --- environment (fish manages its own history; [shell] history_size is not used) ---
for _sc_b in /opt/homebrew:/opt/homebrew /usr/local:/usr/local/Homebrew /home/linuxbrew/.linuxbrew:/home/linuxbrew/.linuxbrew/Homebrew
    set -l parts (string split : $_sc_b)
    if test -x $parts[1]/bin/brew
        set -gx HOMEBREW_PREFIX $parts[1]
        set -gx HOMEBREW_CELLAR $parts[1]/Cellar
        set -gx HOMEBREW_REPOSITORY $parts[2]
        fish_add_path -g $parts[1]/bin $parts[1]/sbin
        break
    end
end
set -e _sc_b
fish_add_path -g $HOME/.local/bin
set -gx EDITOR 'nvim'
set -gx GREETING 'it\'s here'

# --- tools (init output cached; regenerated when the binary changes) ---
function _sc_cached_init
    set -l name $argv[1]
    set -e argv[1]
    set -l bin (command -v $argv[1]); or return 0
    set -l f $_sc_cache/init/$name.fish
    if not test -s $f; or test $bin -nt $f
        mkdir -p (dirname $f)
        $argv >$f 2>/dev/null; or begin
            rm -f $f
            return 0
        end
    end
    source $f
end
# shellcraft's own completions: generated once, loaded by fish on the first Tab (not at startup)
set -l _sc_cf $_sc_cache/completions/shellcraft.fish
if not test -s $_sc_cf; or test (command -v shellcraft) -nt $_sc_cf
    mkdir -p $_sc_cache/completions
    command shellcraft completions fish >$_sc_cf 2>/dev/null
end
set -g fish_complete_path $_sc_cache/completions $fish_complete_path
_sc_cached_init zoxide zoxide init fish
_sc_cached_init fzf fzf --fish
_sc_cached_init atuin atuin init fish --disable-up-arrow
functions -e _sc_cached_init

# --- history (recorded by shellcraft: Ctrl-R searches it) ---
if command -q shellcraft
  function _sc_hist_post --on-event fish_postexec
    set -l ec $status
    command shellcraft hist add --exit $ec --duration $CMD_DURATION --cwd $PWD -- $argv[1] >/dev/null 2>&1 &
    disown 2>/dev/null
  end
  # built-in prompt: directory, duration, exit status and symbol are drawn here; only the plugin
  # segments (git, versions, ...) come from shellcraft, fetched in the background. The shell is
  # signalled when they arrive and the prompt is repainted only if they changed.
  set -g _sc_segs ""
  set -g _sc_segs_pwd ""
  set -g _sc_req_pwd ""
  set -g _sc_inflight ""
  set -g _sc_segs_file $_sc_cache/segs.$fish_pid
  function _sc_p_paint   # sgr text
    printf '\e[%sm%s\e[0m' $argv[1] $argv[2]
  end
  # sets _sc_p_head (before the segments) and _sc_p_tail (after) for status $argv[1], duration $argv[2] (ms)
  function _sc_p_build
    set -l st $argv[1]
    set -l ms $argv[2]
    set -l d $PWD
    set -l prefix ""
    set -l rest $d
    if test -n "$HOME"; and begin; test "$d" = "$HOME"; or string match -q -- "$HOME/*" "$d"; end
      set prefix "~"
      set rest (string sub -s (math (string length -- "$HOME") + 1) -- "$d")
    end
    set -l parts (string split -n / -- $rest)
    set -l n (count $parts)
    set -l text
    if test $n -gt 3
      set text "…/"(string join / $parts[-3..-1])
    else if test $n -eq 0
      test -n "$prefix"; and set text $prefix; or set text /
    else if test -z "$prefix"
      set text /(string join / $parts)
    else
      set text "~/"(string join / $parts)
    end
    set -l h ""
    if set -q SSH_CONNECTION
      set h (_sc_p_paint '90' "$USER@"(prompt_hostname))" "
    end
    set -g _sc_p_head "$h"(_sc_p_paint '34' "$text")
    set -l t ""
    if test 2000 -gt 0; and test "$ms" -ge 2000
      set -l s (math --scale 0 "$ms / 1000")
      if test $s -eq 0
        set text "$ms"ms
      else if test $s -lt 60
        set text "$s"s
      else if test $s -lt 3600
        set text (math --scale 0 "$s / 60")m(math "$s % 60")s
      else
        set text (math --scale 0 "$s / 3600")h(math --scale 0 "($s % 3600) / 60")m
      end
      set t " "(_sc_p_paint '33' "$text")
    end
    if test "$st" -ne 0
      set t "$t "(_sc_p_paint '31' "[$st]")
    end
    if test "$st" -eq 0
      set -g _sc_p_tail "$t "(_sc_p_paint '32' '❯')" "
    else
      set -g _sc_p_tail "$t "(_sc_p_paint '31' '❯')" "
    end
  end
  function fish_prompt
    set -l st $status
    _sc_p_build $st $CMD_DURATION
    set -l segs ""
    test "$_sc_segs_pwd" = "$PWD"; and set segs $_sc_segs
    printf '%s%s%s' "$_sc_p_head" "$segs" "$_sc_p_tail"
  end
  # ask for fresh segments whenever a prompt is about to be shown
  function _sc_prompt_refresh --on-event fish_prompt
    test -n "$_sc_inflight"; and return
    set -g _sc_inflight 1
    set -g _sc_req_pwd $PWD
    command sh -c 'shellcraft prompt --shell fish --segments-only > "$1.tmp" 2>/dev/null && mv "$1.tmp" "$1" && kill -USR1 "$2"' sh $_sc_segs_file $fish_pid >/dev/null 2>&1 &
    disown 2>/dev/null
  end
  function _sc_prompt_ready --on-signal USR1
    set -g _sc_inflight ""
    test -r $_sc_segs_file; or return
    read -z -l out < $_sc_segs_file
    if test "$out" != "$_sc_segs"; or test "$_sc_segs_pwd" != "$_sc_req_pwd"
      set -g _sc_segs $out
      set -g _sc_segs_pwd $_sc_req_pwd
      commandline -f repaint
    end
  end
  function _sc_prompt_preexec --on-event fish_preexec
    set -g _sc_inflight ""
  end
  function _sc_prompt_cleanup --on-event fish_exit
    command rm -f $_sc_segs_file $_sc_segs_file.tmp
  end
  function _sc_file_widget
    set -l sel (command shellcraft files | command shellcraft pick --query (commandline -t))
    and commandline -t -- (string escape -- $sel)
    commandline -f repaint
  end
  function _sc_cd_widget
    set -l sel (command shellcraft files --dirs | command shellcraft pick)
    and cd -- $sel
    commandline -f repaint
  end
  bind \ct _sc_file_widget
  bind \ec _sc_cd_widget
  bind ç _sc_cd_widget  # Option+C in macOS Terminal
end

# --- user keys ---
bind \cg 'kill-whole-line'

# --- abbreviations ---

# --- aliases ---
function reload; exec fish $argv; end
function c; clear $argv; end
function ..; cd .. $argv; end
function ...; cd ../.. $argv; end
function gs; git status -sb $argv; end
function gl; git log --oneline --graph --decorate -20 $argv; end
function gd; git diff $argv; end
function gds; git diff --staged $argv; end
function ga; git add $argv; end
function gc; git commit $argv; end
function gp; git push $argv; end
function gpl; git pull --ff-only $argv; end
function gco; git checkout $argv; end
function gb; git branch $argv; end
if command -q shellcraft
    function ls; shellcraft ls $argv; end
    function ll; shellcraft ls -lah $argv; end
    function la; shellcraft ls -a $argv; end
    function lt; shellcraft ls -T $argv; end
    function cat; shellcraft cat $argv; end
end
alias ll 'ls -lah'

# --- jump (frecency directories: j <words>, ji <words> to pick) ---
if command -q shellcraft
  function _sc_jump_add --on-variable PWD
    command shellcraft jump add -- $PWD 2>/dev/null
  end
  function j
    if test (count $argv) -eq 0
      cd ~; return
    end
    if test (count $argv) -eq 1; and test -d $argv[1]
      cd -- $argv[1]; return
    end
    set -l d (command shellcraft jump query $argv); or begin
      echo "j: no match for: $argv" >&2; return 1
    end
    cd -- $d
  end
  function ji
    set -l d (command shellcraft jump list $argv | sed 's/^ *[0-9.]*  //' | command shellcraft pick); or return
    cd -- $d
  end
end

# --- command not found: suggest close names; `fix` puts the corrected last command in the buffer ---
if command -q shellcraft
  function fish_command_not_found
    command shellcraft suggest --pretty -- $argv[1]
  end
  function fix
    set -l last $history[1]
    set -l parts (string split -m 1 ' ' -- $last)
    set -l s (command shellcraft suggest -- $parts[1] | head -1); or begin
      echo "fix: no suggestion for $parts[1]" >&2; return 1
    end
    commandline -r -- "$s $parts[2]"
  end
end


# --- functions ---
function mkcd
    mkdir -p -- $argv[1]; and cd -- $argv[1]
end
function extract
    if not test -f "$argv[1]"
        echo "extract: '$argv[1]' is not a file" >&2
        return 1
    end
    switch $argv[1]
        case '*.tar.bz2' '*.tbz2'
            tar xjf $argv[1]
        case '*.tar.gz' '*.tgz'
            tar xzf $argv[1]
        case '*.tar.xz' '*.txz'
            tar xJf $argv[1]
        case '*.tar.zst'
            tar --zstd -xf $argv[1]
        case '*.tar'
            tar xf $argv[1]
        case '*.zip'
            unzip $argv[1]
        case '*.gz'
            gunzip $argv[1]
        case '*.bz2'
            bunzip2 $argv[1]
        case '*.xz'
            unxz $argv[1]
        case '*.7z'
            7z x $argv[1]
        case '*.rar'
            unrar x $argv[1]
        case '*'
            echo "extract: unknown format '$argv[1]'" >&2
            return 1
    end
end
function killport
    if test -z "$argv[1]"
        echo "usage: killport <port>" >&2
        return 1
    end
    set -l pids (lsof -ti tcp:$argv[1] 2>/dev/null)
    if test -z "$pids"
        echo "nothing listening on $argv[1]"
        return 0
    end
    kill -9 $pids; and echo "killed $pids"
end
function path-list
    printf '%s\n' $PATH
end
set -e _sc_cache
